# Copy this file to .env and fill the values
# Never commit the real .env file

# MongoDB Atlas Free connection string
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/dailynexa?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASS@YOUR_CLUSTER.mongodb.net/dailynexa?retryWrites=true&w=majority

# Server
PORT=3000
NODE_ENV=production

# Timezone for daily key (forced Asia/Kolkata)
TZ=Asia/Kolkata

# Admin password (change this!)
ADMIN_PASSWORD=change_this_strong_password_123

# JWT secret for admin tokens (long random string)
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# Optional: comma-separated allowed origins for CORS
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
